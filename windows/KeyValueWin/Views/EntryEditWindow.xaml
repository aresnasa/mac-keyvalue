<Window x:Class="KeyValueWin.Views.EntryEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:h="clr-namespace:KeyValueWin.Helpers"
        Title="Entry" Width="480" Height="500" MinHeight="440"
        ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" x:Name="TitleLabel" Text="新建条目"
               FontSize="20" FontWeight="Bold"
               Foreground="{StaticResource TextPrimary}" Margin="0,0,0,20"/>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel h:StackPanelHelper.Spacing="14">

        <StackPanel h:StackPanelHelper.Spacing="5">
          <TextBlock Text="标题 *" FontSize="11" FontWeight="SemiBold"
                     Foreground="{StaticResource TextSecondary}"/>
          <TextBox x:Name="TxtTitle" FontSize="13"/>
        </StackPanel>

        <StackPanel h:StackPanelHelper.Spacing="5">
          <TextBlock Text="用户名 / 账号" FontSize="11" FontWeight="SemiBold"
                     Foreground="{StaticResource TextSecondary}"/>
          <TextBox x:Name="TxtKey" FontSize="13"/>
        </StackPanel>

        <StackPanel h:StackPanelHelper.Spacing="5">
          <TextBlock Text="密码 / 值 *" FontSize="11" FontWeight="SemiBold"
                     Foreground="{StaticResource TextSecondary}"/>
          <Grid>
            <PasswordBox x:Name="PwdValue" FontSize="14" Padding="8,6"
                         BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
            <TextBox x:Name="TxtValuePlain" FontSize="13" Visibility="Collapsed"
                     AcceptsReturn="True" TextWrapping="Wrap" Height="80"
                     VerticalScrollBarVisibility="Auto"/>
          </Grid>
          <StackPanel Orientation="Horizontal" h:StackPanelHelper.Spacing="6">
            <CheckBox Content="显示密码" x:Name="ChkShow"
                      Checked="OnShowPasswordChanged" Unchecked="OnShowPasswordChanged"
                      FontSize="11" Foreground="{StaticResource TextSecondary}"/>
          </StackPanel>
        </StackPanel>

        <StackPanel h:StackPanelHelper.Spacing="5">
          <TextBlock Text="URL / 主机" FontSize="11" FontWeight="SemiBold"
                     Foreground="{StaticResource TextSecondary}"/>
          <TextBox x:Name="TxtUrl" FontSize="13"/>
        </StackPanel>

        <StackPanel h:StackPanelHelper.Spacing="5">
          <TextBlock Text="分组" FontSize="11" FontWeight="SemiBold"
                     Foreground="{StaticResource TextSecondary}"/>
          <TextBox x:Name="TxtGroup" FontSize="13"/>
        </StackPanel>

        <StackPanel h:StackPanelHelper.Spacing="5">
          <TextBlock Text="分类" FontSize="11" FontWeight="SemiBold"
                     Foreground="{StaticResource TextSecondary}"/>
          <ComboBox x:Name="CboCategory" FontSize="13"
                    Padding="8,6" BorderBrush="{StaticResource BorderBrush}"
                    SelectionChanged="OnCategoryChanged">
            <ComboBoxItem Content="🔒  密码" Tag="password" IsSelected="True"/>
            <ComboBoxItem Content="📄  代码片段"  Tag="snippet"/>
            <ComboBoxItem Content="📋  剪贴板" Tag="clipboard"/>
            <ComboBoxItem Content="⌨  命令"   Tag="command"/>
            <ComboBoxItem Content="📦  其他"     Tag="other"/>
          </ComboBox>
        </StackPanel>

        <StackPanel h:StackPanelHelper.Spacing="5">
          <TextBlock Text="标签（逗号分隔）" FontSize="11" FontWeight="SemiBold"
                     Foreground="{StaticResource TextSecondary}"/>
          <TextBox x:Name="TxtTags" FontSize="13"/>
        </StackPanel>

        <StackPanel h:StackPanelHelper.Spacing="5">
          <TextBlock Text="备注" FontSize="11" FontWeight="SemiBold"
                     Foreground="{StaticResource TextSecondary}"/>
          <TextBox x:Name="TxtNotes" FontSize="13" Height="80" TextWrapping="Wrap"
                   AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
        </StackPanel>

        <CheckBox x:Name="ChkFavorite" Content="⭐  标记为收藏"
                  FontSize="13" Foreground="{StaticResource TextPrimary}"/>
        <CheckBox x:Name="ChkPrivate"  Content="🔒  私密条目"
                  FontSize="13" Foreground="{StaticResource TextPrimary}"/>
      </StackPanel>
    </ScrollViewer>

    <!-- Buttons -->
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                h:StackPanelHelper.Spacing="8" Margin="0,16,0,0">
      <Button Content="取消" Style="{StaticResource SecondaryButton}"
              IsCancel="True"/>
      <Button Content="保存" Style="{StaticResource PrimaryButton}"
              IsDefault="True" Click="OnSaveClicked"/>
    </StackPanel>
  </Grid>
</Window>
